# systemd unit for the FastAPI backend. Runs uvicorn from the project venv as a
# managed service: restarts on crash, starts on boot.
#
# Install on the droplet:
#   sudo cp deploy/job-tracker.service /etc/systemd/system/job-tracker.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now job-tracker
#   systemctl status job-tracker      # check it's running
#
# Assumes the repo lives at /opt/job-tracker and a non-root "deploy" user owns
# it. Adjust the paths/user if you deploy elsewhere.

[Unit]
Description=Job & Scholarship Tracker (FastAPI backend)
# Postgres must be up before the app tries to connect.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/job-tracker/backend

# uvicorn from the project's venv, bound to localhost ONLY — the app is never
# exposed to the internet directly; Caddy proxies to it. Config and secrets are
# read from backend/.env by pydantic-settings (cwd = WorkingDirectory above).
ExecStart=/opt/job-tracker/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
